# Additional opt-in switch for `pnpm run test:worker-e2e:repair` ONLY (loaded after worker-e2e.env).
# Enables the broken-fixture repair scenario with SCRIPTED Analyst/Fixer outputs (not live Kiro).
# Contains no paths and no secrets. `pnpm test` and `pnpm run test:worker-e2e` do not load it.
GRAVEYARD_MANUAL_WORKER_E2E_REPAIR=1
