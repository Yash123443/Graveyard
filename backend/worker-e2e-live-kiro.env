# Additional opt-in switch for `pnpm run test:worker-e2e:live-kiro` ONLY (loaded after worker-e2e.env).
# WARNING: this makes the harness call the REAL kiro-cli (one Analyst and one Fixer request per attempt)
# and SPENDS KIRO CREDITS. Bounded redacted fixture evidence leaves the machine for Kiro's service.
# Contains no paths and no secrets. `pnpm test`, `test:worker-e2e` and `test:worker-e2e:repair` do not load it.
GRAVEYARD_MANUAL_WORKER_E2E_LIVE_KIRO=1
