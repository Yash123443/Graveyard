# Opt-in switch for `pnpm run test:worker-e2e` ONLY. Contains no paths and no secrets.
# The operator still supplies GRAVEYARD_NPM_FIXTURE_DIR and GRAVEYARD_NPM_CACHE_DIR in the shell.
# `pnpm test` does not load this file, so the real-Docker harness stays skipped there.
GRAVEYARD_MANUAL_WORKER_E2E=1
