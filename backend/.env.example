# GRAVEYARD backend — example environment variables
#
# Copy this file to .env and adjust values for your local setup.
# Load with: node --env-file=.env dist/server.js
#
# No dotenv package is required; --env-file is built into Node.js 20.6+.

# TCP port the server listens on. Integer 1–65535. Default: 3002
PORT=3002

# Host/IP the server binds to. Default: 127.0.0.1 (loopback only)
# Use 0.0.0.0 to accept connections on all interfaces.
HOST=127.0.0.1

# Pino log level. One of: fatal error warn info debug trace silent. Default: info
LOG_LEVEL=info

# Path to the SQLite database file. The directory is created automatically.
# Use :memory: for an ephemeral in-process database (tests only).
# Default: ./data/graveyard.sqlite
DATABASE_PATH=./data/graveyard.sqlite
