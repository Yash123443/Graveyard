# GRAVEYARD backend — example environment variables
#
# Copy this file to .env and adjust values for your local setup.
# Load with: node --env-file=.env dist/server.js
#
# No dotenv package is required; --env-file is built into Node.js 20.6+.

# TCP port the server listens on. Integer 1–65535. Default: 3002
PORT=3002

# Host/IP the server binds to. Default: 127.0.0.1 (loopback only)
# Use 0.0.0.0 to accept connections on all interfaces.
HOST=127.0.0.1

# Pino log level. One of: fatal error warn info debug trace silent. Default: info
LOG_LEVEL=info

# Path to the SQLite database file. The directory is created automatically.
# Use :memory: for an ephemeral in-process database (tests only).
# Default: ./data/graveyard.sqlite
DATABASE_PATH=./data/graveyard.sqlite

# ---------------------------------------------------------------------------
# Opt-in local worker (separate process: `pnpm run worker`). Everything below is
# commented out on purpose: the API never starts a worker and the worker does
# nothing unless GRAVEYARD_WORKER_ENABLED is exactly 1. It runs ONLY the
# operator-prepared fixtures listed in the catalog; any other repository URL is
# refused (nothing is cloned or run). Needs Docker and a local node:22-alpine.
# See backend/README.md "Local worker" for the catalog format and the limits.
# ---------------------------------------------------------------------------
# GRAVEYARD_WORKER_ENABLED=1
# GRAVEYARD_FIXTURES_ROOT=C:\absolute\path\to\fixtures
# GRAVEYARD_STAGING_ROOT=C:\absolute\path\to\staging
# GRAVEYARD_NPM_CACHE_DIR=C:\absolute\path\to\npm-cache
# GRAVEYARD_FIXTURE_CATALOG=C:\absolute\path\to\catalog.json
# GRAVEYARD_WORKER_ID=worker-1
# GRAVEYARD_WORKER_POLL_MS=2000
# GRAVEYARD_WORKER_RECOVER_MS=30000
# GRAVEYARD_WORKER_BATCH=5
# GRAVEYARD_WORKER_SHUTDOWN_MS=45000
# off | kiro-v2 | kiro-v3. Anything but off sends bounded, redacted evidence to Kiro's service.
# GRAVEYARD_WORKER_AGENTS=off
